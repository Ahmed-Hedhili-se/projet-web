# Copy this file to .env and adjust the values.

PORT=3000
DATABASE_URL="postgresql://neurogrid:neurogrid@localhost:5432/neurogrid?schema=public"
REDIS_URL="redis://localhost:6379"

# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="24h"

CORS_ORIGIN="http://localhost:4200"

# Admin account created by `npx prisma db seed`
ADMIN_EMAIL="admin@neurogrid.dev"
ADMIN_PASSWORD="ChangeMe123!"
