# Copy this file to .env and adjust the values.

PORT=3000
DATABASE_URL="postgresql://neurogrid:neurogrid@localhost:5432/neurogrid?schema=public"
REDIS_URL="redis://localhost:6379"

# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="24h"

CORS_ORIGIN="http://localhost:4200"

# Admin account created by `npx prisma db seed`
ADMIN_EMAIL="admin@neurogrid.dev"
ADMIN_PASSWORD="ChangeMe123!"

# AI GPU advisor (GitHub token: reads public repos + GitHub Models LLM)
# Create a fine-grained token at https://github.com/settings/personal-access-tokens
#   - Repository access: "Public repositories" (read-only)
#   - Account permissions: "Models" -> Read-only
# Leave empty: the site still works, only the advisor chat is disabled.
GITHUB_TOKEN=""
LLM_PROVIDER="github"
LLM_MODEL="openai/gpt-4.1"
# Any OpenAI-compatible API works (GitHub Models by default). Empty LLM_API_KEY = use GITHUB_TOKEN.
LLM_BASE_URL="https://models.github.ai/inference"
LLM_API_KEY=""
AGENT_DAILY_LIMIT=30
